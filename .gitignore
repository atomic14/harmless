# dependencies & build output
node_modules/
dist/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# local scratch (training logs in train/logs/ ARE committed —
# they're the recorded evidence for docs/TRAINING-LOG.md)
*.local
# a root scratch file is on no include list, so no gate ever reads it.
# tmp-jump.ts sat here from 2026-08-11 and stopped compiling (docs/TODO/164).
tmp-*.ts

# unposterised model output — kept locally so the posterise can be re-tuned
# without regenerating (tools/posterise.py), too heavy to commit
tools/species-raw/

# python bytecode from tools/
__pycache__/
*.pyc

# local architecture-review output; keep the adjudicated baseline
.architecture-review/*
!.architecture-review/baseline.json

# scratch worktrees from parallel agent runs
.claude/worktrees/

# graphify knowledge graph — 7 MB of generated output, rebuilt from the repo.
# tools/graphify-augment.py IS committed: it is the repair pass, not the output.
graphify-out/
.cycle/
