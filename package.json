{
  "name": "harmless",
  "version": "1.0.0",
  "description": "A web remake of the classic 1984 Elite: byte-accurate procedural galaxy, wireframe ships, shader planets — and ship AI trained by neuroevolution self-play.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit",
    "generate:constants": "node --experimental-strip-types --no-warnings tools/constants.ts generate",
    "generate:palette": "node --experimental-strip-types --no-warnings tools/palette.ts generate",
    "generate:elite-a": "node tools/import-elite-a.mjs",
    "generate:danube": "node --experimental-strip-types --no-warnings tools/import-danube.ts",
    "generate:descriptions": "node --experimental-strip-types --no-warnings tools/generate-descriptions.ts",
    "constants:find": "node --experimental-strip-types --no-warnings tools/constants.ts find",
    "constants:check": "node --experimental-strip-types --no-warnings tools/constants.ts check",
    "palette:check": "node --experimental-strip-types --no-warnings tools/palette.ts check",
    "claims:check": "node tools/internal-claims.mjs",
    "check": "npm run lint && npm test && npm run sizes && npm run constants:check && npm run palette:check && npm run claims:check && npm run generate:elite-a -- --check && npm run generate:danube -- --check && npm run generate:descriptions -- --check",
    "prebuild": "npm run check",
    "build": "vite build",
    "preview": "vite preview",
    "train": "node --experimental-strip-types --no-warnings train/evolve.ts",
    "evaluate": "node --experimental-strip-types --no-warnings train/evaluate.ts",
    "test": "node --experimental-strip-types --no-warnings test/run.ts",
    "elite-a": "npm run generate:elite-a -- --check && node --experimental-strip-types --no-warnings test/elite-a.ts",
    "campaign": "node --experimental-strip-types --no-warnings test/campaign.ts",
    "survivability": "node --experimental-strip-types --no-warnings train/survivability.ts",
    "flight-probe": "node --experimental-strip-types --no-warnings train/flight-probe.ts",
    "aim-probe": "node --experimental-strip-types --no-warnings train/aim-probe.ts",
    "ram-probe": "node --experimental-strip-types --no-warnings train/ram-probe.ts",
    "gap-probe": "node --experimental-strip-types --no-warnings train/gap-probe.ts",
    "defence-probe": "node --experimental-strip-types --no-warnings train/defence-probe.ts",
    "dock-probe": "node --experimental-strip-types --no-warnings train/dock-probe.ts",
    "dock-traffic": "node --experimental-strip-types --no-warnings train/dock-traffic.ts",
    "roster-probe": "node --experimental-strip-types --no-warnings train/roster-probe.ts",
    "portability": "node tools/portability.test.mjs && node tools/portability.mjs",
    "sizes": "node tools/sizes.mjs",
    "coverage": "node tools/coverage.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
